{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "pedidos-route": {
        "ClusterId": "pedidos-cluster",
        "Match": {
          "Path": "/api/pedidos/{**catch-all}"
        }
      },
      "catalogo-route": {
        "ClusterId": "catalogo-cluster",
        "RateLimiterPolicy": "IpRateLimit",
        "Match": {
          "Path": "/api/produtos/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5025"
          }
        }
      },
      "pedidos-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "instancia-1": {
            "Address": "http://localhost:5290"
          }
        }
      },
      "catalogo-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "instancia-1": {
            "Address": "http://ecommerce-catalogo-api:8080"
          }
        }
      }
    }
  }
}