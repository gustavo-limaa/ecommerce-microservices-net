{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "pedidos-route": {
        "ClusterId": "pedidos-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/pedidos/{**catch-all}"
        }
      },
      "pedidos-sincronizados-route": {
        "ClusterId": "pedidos-cluster",
        "Match": {
          "Path": "/api/produtossincronizados/{**catch-all}"
        }
      },
      "catalogo-route-leitura": {
        "ClusterId": "catalogo-cluster",
        "RateLimiterPolicy": "IpRateLimit",
        "Match": {
          "Path": "/api/produtos/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "catalogo-route-escrita": {
        "ClusterId": "catalogo-cluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/produtos/{**catch-all}",
          "Methods": [ "POST", "PUT", "PATCH", "DELETE" ]
        }
      },
      "catalogo-categorias-route": {
        "ClusterId": "catalogo-cluster",
        "Match": {
          "Path": "/api/categorias/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "http://ecommerce-auth-api:8080"
          }
        }
      },
      "pedidos-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "instancia-1": {
            "Address": "http://ecommerce-pedido-api:8080"
          }
        }
      },
      "catalogo-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "instancia-1": {
            "Address": "http://ecommerce-catalogo-api:8080"
          }
        }
      }
    }
  }
}